# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# Inbox that receives inquiry-form leads (e.g. partners@nightfuel.com)
LEAD_INBOX_EMAIL=

# Verified Resend sender address. Use onboarding@resend.dev until the
# production domain is verified in Resend.
LEAD_FROM_EMAIL=

# Public base URL, used for canonical URLs, OG tags, and sitemap.
# Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Set to "true" to render the map slot on /find-a-machine.
# Leave unset until a real map is implemented.
# NEXT_PUBLIC_MAP_ENABLED=
